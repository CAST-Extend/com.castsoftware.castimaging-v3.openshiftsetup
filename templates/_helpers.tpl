{{/*
Short hash suffix for one-shot Job names. A Job's spec.template is immutable, so changing it in place
(helm upgrade, or Argo CD even with Replace=true) is rejected. Changing the name whenever the chart version,
the values or the Job's script change makes Helm/Argo CD create a new Job and prune the old one instead of
patching it.

Usage: include "imaging.jobSuffix" (list . "<configmap template file>" "<script key>")
The script is read from the rendered ConfigMap, so only that key is hashed: editing another script of the
same ConfigMap does not re-run the Job.
*/}}
{{- define "imaging.jobSuffix" -}}
{{- $root := index . 0 -}}
{{- $script := "" -}}
{{- if gt (len .) 2 -}}
{{- $key := index . 2 -}}
{{- $rendered := include (printf "%s/%s" $root.Template.BasePath (index . 1)) $root -}}
{{- range regexSplit "(?m)^---\\s*$" $rendered -1 -}}
{{- $doc := fromYaml . -}}
{{- if and $doc.data (hasKey $doc.data $key) -}}
{{- $script = index $doc.data $key -}}
{{- end -}}
{{- end -}}
{{- if not $script -}}
{{- fail (printf "imaging.jobSuffix: key %q not found in %s" $key (index . 1)) -}}
{{- end -}}
{{- end -}}
{{- printf "%s-%s-%s" $root.Chart.Version (toYaml $root.Values) $script | sha256sum | trunc 8 -}}
{{- end -}}

{{/*
Custom labels / annotations (values: standardLabels, commonLabels, commonAnnotations, resourceMetadata,
componentMetadata). Merged in this order, the last one wins:
  1. standard labels generated by the chart (labels only, when standardLabels=true):
     app.kubernetes.io/name (= component), app.kubernetes.io/instance, app.kubernetes.io/version,
     app.kubernetes.io/managed-by, app.kubernetes.io/part-of, helm.sh/chart
  2. commonLabels / commonAnnotations
  3. resourceMetadata.<kind>.labels / .annotations
  4. componentMetadata.<component>.labels / .annotations

"imaging.mergeMetadata" fills the dict passed as "out" (maps are passed by reference) and renders nothing.
Called with a dict: "ctx" = root context, "kind" = resourceMetadata key, "component" = componentMetadata key
("" for resources shared by all components), "field" = "labels" or "annotations", "out" = dict to fill,
"standard" = whether to add the standard labels.
*/}}
{{- define "imaging.mergeMetadata" -}}
{{- $v := .ctx.Values -}}
{{- $out := .out -}}
{{- if and .standard (eq .field "labels") $v.standardLabels -}}
{{- $_ := set $out "app.kubernetes.io/name" (.component | default "castimaging") -}}
{{- $_ := set $out "app.kubernetes.io/instance" .ctx.Release.Name -}}
{{- $_ := set $out "app.kubernetes.io/version" .ctx.Chart.AppVersion -}}
{{- $_ := set $out "app.kubernetes.io/managed-by" .ctx.Release.Service -}}
{{- $_ := set $out "app.kubernetes.io/part-of" "castimaging" -}}
{{- $_ := set $out "helm.sh/chart" (printf "%s-%s" .ctx.Chart.Name .ctx.Chart.Version | replace "+" "_") -}}
{{- end -}}
{{- $sources := list (index $v (printf "common%s" (title .field))) -}}
{{- with $v.resourceMetadata }}{{ with index . $.kind }}{{ $sources = append $sources (index . $.field) }}{{ end }}{{ end -}}
{{- if .component }}{{ with $v.componentMetadata }}{{ with index . $.component }}{{ $sources = append $sources (index . $.field) }}{{ end }}{{ end }}{{ end -}}
{{- range $sources }}{{ range $k, $val := . }}{{ $_ := set $out $k $val }}{{ end }}{{ end -}}
{{- end -}}

{{/*
Renders the merged labels or annotations of a metadata block (see "imaging.mergeMetadata" for the parameters).
- without "block": entries only, to be included under an existing "labels:" / "annotations:" key,
  "indent" = indentation of the entries;
- with "block" true: "labels:" / "annotations:" key + entries, for a metadata block that has no such key,
  "indent" = indentation of the key. Nothing is rendered when there is no entry.
Each line is preceded by a newline, so the include must be written with "{{-".
*/}}
{{- define "imaging.metadata" -}}
{{- $out := dict -}}
{{- $_ := include "imaging.mergeMetadata" (dict "ctx" .ctx "kind" .kind "component" .component "field" .field "out" $out "standard" true) -}}
{{- include "imaging.renderMetadata" (dict "entries" $out "field" .field "indent" .indent "block" .block) -}}
{{- end -}}

{{- define "imaging.renderMetadata" -}}
{{- if .entries -}}
{{- $indent := .indent -}}
{{- if .block }}
{{ printf "%s:" .field | indent .indent }}
{{- $indent = int (add .indent 2) -}}
{{- end -}}
{{- range $k, $val := .entries }}
{{ $k | indent $indent }}: {{ $val | toString | quote }}
{{- end -}}
{{- end -}}
{{- end -}}

{{/*
Labels / annotations of a StatefulSet volumeClaimTemplate (kind "pvc"). "volumeClaimTemplates" is immutable:
- nothing is rendered unless commonLabels/commonAnnotations, resourceMetadata.pvc or
  componentMetadata.<component> provide something for PVCs (existing deployments are left unchanged);
- if the StatefulSet already exists in the cluster, the labels / annotations currently set on that template
  are rendered as-is, so the template is never modified by an upgrade.
"lookup" returns nothing with "helm template" (e.g. Argo CD) / client-side "--dry-run": the template is then
always rendered as for a first install, and Argo CD must ignore spec.volumeClaimTemplates (ignoreDifferences
+ RespectIgnoreDifferences=true) to upgrade an existing StatefulSet.
Called with a dict: "ctx" = root context, "apiVersion" / "statefulset" = StatefulSet apiVersion / name,
"claim" = template name, "component" = componentMetadata key, "indent" = indentation of the keys.
*/}}
{{- define "imaging.volumeClaimTemplateMetadata" -}}
{{- $labels := dict -}}
{{- $annotations := dict -}}
{{- $_ := include "imaging.mergeMetadata" (dict "ctx" .ctx "kind" "pvc" "component" .component "field" "labels" "out" $labels "standard" false) -}}
{{- $_ := include "imaging.mergeMetadata" (dict "ctx" .ctx "kind" "pvc" "component" .component "field" "annotations" "out" $annotations "standard" false) -}}
{{- if or $labels $annotations -}}
{{- $labels = dict -}}
{{- $_ := include "imaging.mergeMetadata" (dict "ctx" .ctx "kind" "pvc" "component" .component "field" "labels" "out" $labels "standard" true) -}}
{{- end -}}
{{- $sts := lookup .apiVersion "StatefulSet" .ctx.Release.Namespace .statefulset -}}
{{- if $sts -}}
{{- $labels = dict -}}
{{- $annotations = dict -}}
{{- range $sts.spec.volumeClaimTemplates -}}
{{- if eq .metadata.name $.claim -}}
{{- $labels = .metadata.labels | default dict -}}
{{- $annotations = .metadata.annotations | default dict -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- include "imaging.renderMetadata" (dict "entries" $labels "field" "labels" "indent" .indent "block" true) -}}
{{- include "imaging.renderMetadata" (dict "entries" $annotations "field" "annotations" "indent" .indent "block" true) -}}
{{- end -}}

{{/*
Security contexts (values: podSecurityContext, containerSecurityContext, componentSecurityContext).
Merged in this order, the last one wins:
  1. the security context set by the chart ("restricted" true: runAsNonRoot + seccompProfile RuntimeDefault for
     a pod, allowPrivilegeEscalation false + drop ALL capabilities for a container, plus seccompProfile
     RuntimeDefault when "seccomp" is true)
  2. podSecurityContext / containerSecurityContext
  3. componentSecurityContext.<component>.pod / .container
Maps (seccompProfile, seLinuxOptions, capabilities...) are merged key by key, a null value removes the key.
Nothing is rendered when the result is empty (pods / containers without security context are left unchanged).
Called with a dict: "ctx" = root context, "component" = componentSecurityContext key, "restricted" / "seccomp"
= chart defaults (see above), "indent" = indentation of the "securityContext:" key.
Each line is preceded by a newline, so the include must be written with "{{-".
*/}}
{{- define "imaging.podSecurityContext" -}}
{{- $defaults := dict -}}
{{- if .restricted -}}
{{- $defaults = dict "runAsNonRoot" true "seccompProfile" (dict "type" "RuntimeDefault") -}}
{{- end -}}
{{- include "imaging.securityContext" (dict "ctx" .ctx "component" .component "field" "pod" "defaults" $defaults "indent" .indent) -}}
{{- end -}}

{{- define "imaging.containerSecurityContext" -}}
{{- $defaults := dict -}}
{{- if .restricted -}}
{{- $defaults = dict "allowPrivilegeEscalation" false "capabilities" (dict "drop" (list "ALL")) -}}
{{- end -}}
{{- if .seccomp -}}
{{- $_ := set $defaults "seccompProfile" (dict "type" "RuntimeDefault") -}}
{{- end -}}
{{- include "imaging.securityContext" (dict "ctx" .ctx "component" .component "field" "container" "defaults" $defaults "indent" .indent) -}}
{{- end -}}

{{- define "imaging.securityContext" -}}
{{- $v := .ctx.Values -}}
{{- $out := .defaults -}}
{{- $sources := list (index $v (printf "%sSecurityContext" .field)) -}}
{{- with $v.componentSecurityContext }}{{ with index . $.component }}{{ $sources = append $sources (index . $.field) }}{{ end }}{{ end -}}
{{- range $src := $sources }}{{ range $k, $val := $src -}}
{{- if kindIs "invalid" $val -}}
{{- $_ := unset $out $k -}}
{{- else if and (kindIs "map" $val) (kindIs "map" (index $out $k)) -}}
{{- $sub := index $out $k -}}
{{- range $k2, $val2 := $val -}}
{{- if kindIs "invalid" $val2 }}{{ $_ := unset $sub $k2 }}{{ else }}{{ $_ := set $sub $k2 (deepCopy $val2) }}{{ end -}}
{{- end -}}
{{- else -}}
{{- $_ := set $out $k (deepCopy $val) -}}
{{- end -}}
{{- end }}{{ end -}}
{{- if $out }}
{{ "securityContext:" | indent .indent }}
{{- toYaml $out | nindent (int (add .indent 2)) }}
{{- end -}}
{{- end -}}
